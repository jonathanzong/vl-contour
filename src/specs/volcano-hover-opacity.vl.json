{
  "description": "A contour plot of the Maungawhau volcano in New Zealand.",
  "data": {"url": "data/volcano.json"},
  "mark": {
    "type": "contour",
    "smooth": true,
    "thresholds": {"expr": "sequence(90, 195, 5)"}
  },
  "encoding": {
    "stroke": {"value": "#ccc"},
    "color": {
      "scale": {"scheme": "blueorange"}
    },
    "opacity": {
      "condition": {
        "param": "selection",
        "value": 1
      },
      "value": 0.1
    }
  },
  "params": [
    {
      "name": "selection",
      "select": {
        "type": "point",
        "on": "mouseover",
        "fields": ["contourValue"]
      }
    }
  ]
}